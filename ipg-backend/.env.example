PORT=4000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=ipg
DB_PASSWORD=ipg
DB_DATABASE=packeta_ipg

# Shared secret merchants (Packeta's backend) must send when creating a
# payment or verifying one. Not required on the browser-facing confirm/cancel
# endpoints, since those are only reachable with the unguessable authority.
IPG_API_KEY=sandbox-ipg-key

# Where the pay page lives (ipg-frontend), used to build the paymentUrl
# returned from POST /payments.
IPG_FRONTEND_URL=http://localhost:5174
