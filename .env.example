# Copy to .env at the repo root and fill in for a real deployment.
# Every value here is optional for local dev — docker-compose.yml already
# has safe localhost/sandbox defaults — but on any server reachable from
# the public internet, treat PUBLIC_HOST, JWT_SECRET, and the
# MONGO_EXPRESS_* credentials as required, not optional.

# The IP or domain the *customer's browser* will reach this deployment at
# (not a docker-network hostname). Used to build FRONTEND_URL,
# IPG_FRONTEND_URL, and the frontends' VITE_API_URL/VITE_PACKETA_API_URL —
# see docker-compose.yml's header comment for why. Baked into the frontend
# bundles at build time, so changing this needs `docker compose up --build`.
PUBLIC_HOST=localhost

# Signs every issued JWT. Any long random string — e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Shared between backend and ipg-backend to authenticate their
# server-to-server calls. Any string both sides agree on.
IPG_API_KEY=sandbox-ipg-key

# ZarinPal (real payment gateway backing deposits and CREDIT top-ups).
# Sandbox settles no real money and accepts any well-formed merchant id;
# switch both to production + a real merchant id to go live.
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# mongo-express (Mongo browsing UI, http://<PUBLIC_HOST>:8081) basic-auth
# login. The compose defaults (admin/admin) are fine for local dev only —
# change these before exposing this stack to the public internet.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin
