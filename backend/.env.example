PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=packeta
DB_PASSWORD=packeta
DB_DATABASE=packeta

MONGO_URI=mongodb://localhost:27017/packeta_logs

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# The sandbox IPG (ipg-backend/) that PURCHASE/installment-repayment
# initiate/verify calls out to.
IPG_BASE_URL=http://localhost:4000
IPG_API_KEY=sandbox-ipg-key

# ZarinPal — the real-money gateway DEPOSIT initiate/verify calls out to.
# Defaults to ZarinPal's public sandbox, which settles no real money and
# accepts any well-formed merchant id; point both at production to go live.
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sadad (Bank Melli PSP) — alternative real-money gateway. A super-admin
# picks ZarinPal or Sadad in Admin → Payment Gateway; Sadad can only be
# activated once all three credentials below are set. TerminalKey is the
# Base64 key from Sadad (24 bytes decoded). Wallet amounts are multiplied by
# SADAD_AMOUNT_MULTIPLIER (10 = Toman → Rial) before being sent to Sadad.
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_TERMINAL_KEY=
SADAD_AMOUNT_MULTIPLIER=10
SADAD_API_URL=https://sadad.shaparak.ir
SADAD_PURCHASE_URL=https://sadad.shaparak.ir

# This backend's public URL — Sadad POSTs the customer back to
# <BACKEND_PUBLIC_URL>/payment-gateway/sadad/return.
BACKEND_PUBLIC_URL=http://localhost:3000

# Where the customer's browser lands after the IPG redirects back.
FRONTEND_URL=http://localhost:5173

# The IPG's own pay page (ipg-frontend) — where a ZarinPal credit-shortfall
# top-up's callback returns to, instead of Packeta's own app.
IPG_FRONTEND_URL=http://localhost:5174
