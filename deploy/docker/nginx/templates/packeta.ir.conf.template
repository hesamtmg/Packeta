# Wallet app, at ${WALLET_DOMAIN}. Rendered from this .template file by the
# official nginx image's docker-entrypoint envsubst step (files under
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf on container
# start), using the WALLET_DOMAIN env var set on the nginx service in
# docker-compose.yml. Only variables actually present in the container's
# environment get substituted, so nginx's own $host/$remote_addr/etc. below
# are left untouched.
#
# frontend/ipg-backend containers aren't reachable from outside the compose
# network — this is the only public entry point. /api/ is proxied to the
# backend container with the prefix stripped, since the backend itself has
# no /api prefix (see backend/src/main.ts).

server {
    listen 80;
    server_name ${WALLET_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${WALLET_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WALLET_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WALLET_DOMAIN}/privkey.pem;

    # Avatar uploads and Excel batch imports go through /api/.
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://backend:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # frontend container runs `vite preview`, which already serves the built
    # SPA with history-mode fallback — nginx just proxies to it.
    location / {
        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
