# IPG pay page, at ${PAY_DOMAIN}. See packeta.ir.conf.template for the
# templating mechanics (WALLET_DOMAIN/PAY_DOMAIN are set on the nginx
# service in docker-compose.yml and substituted at container start).
#
# ipg-frontend also calls Packeta's own backend directly (phone+OTP
# identification, wallet selection on a merchant-initiated charge) — its
# VITE_PACKETA_API_URL build arg points at https://${WALLET_DOMAIN}/api, a
# cross-origin call the Packeta backend already allows via app.enableCors().

server {
    listen 80;
    server_name ${PAY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${PAY_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PAY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PAY_DOMAIN}/privkey.pem;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://ipg-backend:4000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://ipg-frontend:5174;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
