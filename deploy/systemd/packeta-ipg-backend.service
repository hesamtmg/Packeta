[Unit]
Description=Packeta sandbox IPG backend (pay.packeta.ir/api)
After=network.target postgresql.service

[Service]
Type=simple
User=packeta
WorkingDirectory=/var/www/packeta/ipg-backend
EnvironmentFile=/var/www/packeta/ipg-backend/.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
