[Unit]
Description=Packeta wallet backend (packeta.ir/api)
After=network.target postgresql.service mongod.service

[Service]
Type=simple
User=packeta
WorkingDirectory=/var/www/packeta/backend
EnvironmentFile=/var/www/packeta/backend/.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
